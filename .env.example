# Configure in the server shell or hosting settings; no automatic .env loading.
GEMINI_API_KEY=YOUR_SERVER_KEY
# Optional; default gemini-flash-latest
BAYAN_AUDIO_MODEL=YOUR_AUDIO_CAPABLE_MODEL_ID
# Optional; falls back to BAYAN_AUDIO_MODEL
BAYAN_REVIEW_MODEL=YOUR_TEXT_CAPABLE_MODEL_ID
# Team review (hosted): reviewers' password and the Neon connection string.
# Vercel adds DATABASE_URL when Neon is connected; a prefix such as bayan_DATABASE_URL also works.
REVIEW_PASSWORD=CHOOSE_A_TEAM_PASSWORD
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
